{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/topic-researcher-v1/topic-card.schema.json",
  "title": "Topic Researcher V1 Topic Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topic_id",
    "topic",
    "primary_keyword",
    "topic_type",
    "target_markets",
    "output_language",
    "target_customer",
    "search_intent",
    "research_priority",
    "research_mode"
  ],
  "properties": {
    "topic_id": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "minLength": 3
    },
    "primary_keyword": {
      "type": "string",
      "minLength": 1
    },
    "topic_type": {
      "enum": [
        "news",
        "evergreen",
        "mixed"
      ]
    },
    "target_markets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "output_language": {
      "type": "string",
      "minLength": 2
    },
    "target_customer": {
      "type": "string",
      "minLength": 1
    },
    "search_intent": {
      "type": "string",
      "minLength": 1
    },
    "source_trigger": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "knowledge_gap_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "signal_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "primary_source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "topic_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "score_reason": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "research_priority": {
      "enum": [
        "normal",
        "high"
      ]
    },
    "research_mode": {
      "enum": [
        "quick",
        "standard",
        "deep"
      ]
    },
    "upstream": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
